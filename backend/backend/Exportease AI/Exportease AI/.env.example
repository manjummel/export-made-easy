# ============================================================
# ExportEase AI - System 3 Backend Configuration
# EXPORT-EASE-BACKEND-V1
# ============================================================

# --- Service Configuration ---
BACKEND_SERVICE_PORT=8000
BACKEND_HOST=0.0.0.0
DEBUG=true
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql+asyncpg://exportease:exportease_dev@localhost:5432/exportease_db
DATABASE_SYNC_URL=postgresql+psycopg2://exportease:exportease_dev@localhost:5432/exportease_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Authentication ---
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- System 1: AI Engine ---
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=120
AI_SERVICE_API_VERSION=v1

# --- System 2: Knowledge / RAG ---
KNOWLEDGE_SERVICE_URL=http://localhost:8002
KNOWLEDGE_SERVICE_TIMEOUT=60
KNOWLEDGE_SERVICE_API_VERSION=v1

# --- Service Mode ---
REAL_SERVICES=false
MOCK_SERVICES=true

# --- Shared Contracts ---
EXPORTEASE_CONTRACTS_PATH=
EXPORTEASE_CONTRACTS_GIT_URL=

# --- Backend Public URL (for System 4) ---
BACKEND_PUBLIC_URL=http://localhost:8000

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
