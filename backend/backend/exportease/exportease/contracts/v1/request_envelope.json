{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "exportease/contracts/v1/request_envelope",
  "title": "ExportEase Common Request Envelope",
  "version": "v1.0.0",
  "type": "object",
  "required": ["request_id", "api_version"],
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Unique request identifier (UUID-compatible). MUST be preserved in all responses and events."
    },
    "user_id": {
      "type": "string",
      "description": "Authenticated user identifier."
    },
    "project_id": {
      "type": "string",
      "description": "Export project identifier. MUST be preserved end-to-end."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the request."
    },
    "language": {
      "type": "string",
      "enum": ["en", "hi", "ta", "te"],
      "default": "en",
      "description": "Response language. Supported: en (English), hi (Hindi), ta (Tamil), te (Telugu)."
    },
    "api_version": {
      "type": "string",
      "enum": ["v1"],
      "description": "API contract version."
    }
  },
  "additionalProperties": true
}
