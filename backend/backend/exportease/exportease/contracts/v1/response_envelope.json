{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "exportease/contracts/v1/response_envelope",
  "title": "ExportEase Common Response Envelope",
  "version": "v1.0.0",
  "type": "object",
  "required": ["request_id", "status", "api_version", "timestamp"],
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Echo of the original request_id. MUST always be present."
    },
    "project_id": {
      "type": ["string", "null"],
      "description": "Echo of the project_id if provided."
    },
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL_SUCCESS", "INSUFFICIENT_GROUNDING", "LOW_CONFIDENCE", "REVIEW_REQUIRED", "ERROR", "AGENT_FAILED"],
      "description": "Top-level response status."
    },
    "data": {
      "type": "object",
      "description": "Endpoint-specific response payload."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Aggregate confidence score across all agents."
    },
    "sources": {
      "type": "array",
      "items": {"type": "string"},
      "description": "List of source/citation IDs used to generate the response."
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Non-fatal warnings (e.g. low confidence on a sub-component)."
    },
    "errors": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Error messages if status != SUCCESS."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "api_version": {
      "type": "string",
      "enum": ["v1"]
    }
  }
}
